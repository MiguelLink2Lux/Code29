# Frontend environment template — copy to .env and fill in.
# Names only: never commit real values. `.env` is git-ignored.
#
# The contact flow now lives in the FastAPI backend, so RESEND_API_KEY and the
# CONTACT_* addresses belong to backend/.env — see backend/.env.example.

# --- SEO -------------------------------------------------------------------
# Absolute site origin, scheme included. Everything derived from it: canonical
# URLs, og:image, robots.txt and the sitemap. Optional — src/utils/seo.ts falls
# back to https://code29.dev. A value without a scheme fails the build on purpose.
# PUBLIC_SITE_URL=https://example.com

# --- Analytics -------------------------------------------------------------
# GA4 measurement ID. The tag loads only after the visitor grants analytics
# consent; leave it unset and no analytics script is rendered at all.
# PUBLIC_GA4_ID=G-XXXXXXXXXX

# --- Guided contact chat ---------------------------------------------------
# Origin of the FastAPI backend that serves the contact flow. Defaults to
# http://localhost:8000 for local work.
# PUBLIC_API_BASE_URL=https://api.example.com

# Cloudflare Turnstile site key (public half). Without it the chat cannot solve
# the human challenge, so the backend refuses to send a verification code.
# Cloudflare's always-passing test key is 1x00000000000000000000AA.
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
