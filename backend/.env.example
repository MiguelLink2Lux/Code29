# Backend configuration template. Copy to `.env` and adjust.
# Values here are safe defaults/placeholders — never commit real secrets.

# Runtime environment name: development | staging | production
APP_ENV=development

# Comma-separated list of allowed CORS origins.
# Must never be `*` — the app validates and splits this list (see app/core/config.py).
CORS_ORIGINS=http://localhost:4321
