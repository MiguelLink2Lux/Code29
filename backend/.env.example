# Backend configuration template. Copy to `.env` and adjust.
# Values here are safe defaults/placeholders — never commit real secrets.

# Runtime environment name: development | staging | production
APP_ENV=development

# Comma-separated list of allowed CORS origins.
# Must never be `*` — the app validates and splits this list (see app/core/config.py).
CORS_ORIGINS=http://localhost:4321

# --- Guided contact flow ---------------------------------------------------
# All five are required for the flow to run. If any is missing the endpoints
# answer 503 by design instead of half-working, and the chat says "unavailable".

# Signs the verification codes and the access tokens. 32+ random characters:
# in production a shorter value is a hard boot failure, and an absent one fails
# as soon as any other variable below is set.
#   generate with: openssl rand -base64 48
CONTACT_TOKEN_SECRET=

# Resend API key, used to email verification codes and the generated report.
RESEND_API_KEY=

# Verified sender address in Resend, and the mailbox that gets the owner copy
# of every report (which is the only record kept — nothing is persisted).
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Cloudflare Turnstile secret (private half). It is the anti-abuse gate before
# any email is sent; without a store there is no per-address rate limit.
# Cloudflare's always-passing test secret is 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=

# Report generator: `stub` (deterministic template, the default) or `gemini`
# (a real model over the Gemini REST API). `gemini` requires GEMINI_API_KEY.
# Neither value ever falls back silently: a misconfigured `gemini` refuses to
# start rather than emailing a template report as if a model wrote it.
# `genkit` is deliberately rejected — its Gemini plugin does not fit the
# deployment's bundle limit (see ADR 0004).
# REPORT_GENERATOR=stub
# GEMINI_API_KEY=
