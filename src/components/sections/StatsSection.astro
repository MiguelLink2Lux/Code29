---
// Stats section: 4 key performance metrics
import { translations, type Lang } from '@/i18n/translations'
import { DEFAULT_LANG } from '@/utils/i18n'

const lang: Lang = DEFAULT_LANG
const stats = translations.stats[lang]
---

<section class="stats" id="stats" aria-label="Métricas de rendimiento">
  <div class="stats__inner">
    <div class="stats__grid">
      {
        stats.map((stat, i) => (
          <article class="stats__card">
            <span class="stats__value">{stat.value}</span>
            <h3 class="stats__label" data-i18n={`stats.${i}.label`}>{stat.label}</h3>
            <p class="stats__detail" data-i18n={`stats.${i}.detail`}>{stat.detail}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stats {
    background: var(--color-surface-1);
    padding: var(--space-16) var(--space-8);
  }

  .stats__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-1);
  }

  .stats__card {
    background: var(--color-surface-2);
    padding: var(--space-8);
    box-shadow: var(--shadow-ambient);
    transition: box-shadow var(--transition-normal);
  }

  .stats__card:hover {
    box-shadow: 0px 0px 24px rgba(0, 240, 255, 0.12);
  }

  .stats__value {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-primary);
    text-shadow: var(--shadow-glow);
    margin-bottom: var(--space-2);
  }

  .stats__label {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .stats__detail {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .stats {
      padding: var(--space-12) var(--space-4);
    }

    .stats__card {
      padding: var(--space-6);
    }
  }
</style>
