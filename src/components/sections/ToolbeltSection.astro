---
import { translations, type Lang } from '@/i18n/translations'
import { DEFAULT_LANG } from '@/utils/i18n'

const lang: Lang = DEFAULT_LANG
const t = translations.toolbelt[lang]

function renderIcon(icon: string): string {
  switch (icon) {
    case 'github':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18c-4 1.2-4-2-6-2" /><path d="M15 21v-3.2a2.8 2.8 0 0 0-.8-2.2c2.6-.3 5.3-1.3 5.3-6A4.7 4.7 0 0 0 18.2 6 4.3 4.3 0 0 0 18.1 3S17 2.7 15 4a11 11 0 0 0-6 0C7 2.7 5.9 3 5.9 3A4.3 4.3 0 0 0 5.8 6a4.7 4.7 0 0 0-1.3 3.6c0 4.7 2.7 5.7 5.3 6a2.8 2.8 0 0 0-.8 2.2V21" /></svg>`
    case 'jira':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l4.5 4.5L12 12 7.5 7.5 12 3Z" /><path d="M7.5 7.5 12 12l-4.5 4.5L3 12l4.5-4.5Z" /><path d="M16.5 7.5 21 12l-4.5 4.5L12 12l4.5-4.5Z" /></svg>`
    case 'aws':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9.5c1.7-2.2 4.2-3.3 7.5-3.3S17.3 7.3 20 9.5" /><path d="M6 14.8c2 .9 4 1.4 6 1.4s4-.5 6-1.4" /><path d="M7 18c2.7 1.3 5.3 1.3 8 0" /></svg>`
    case 'linear':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="7" /><path d="M9 16 15 8" /><path d="M9 8v8" /></svg>`
    case 'vscode':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.5 4 8 9.8l-3.2-2.4L3 8.9l3.5 3.1L3 15.1l1.8 1.5L8 14.2l7.5 5.8 3.5-1.7V5.7L15.5 4Z" /></svg>`
    case 'android':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 9.5h8a2 2 0 0 1 2 2V16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-4.5a2 2 0 0 1 2-2Z" /><path d="M9 9.5 7.5 7" /><path d="M15 9.5 16.5 7" /><path d="M9.5 13h.01" /><path d="M14.5 13h.01" /></svg>`
    case 'vpn':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v5c0 4.3 2.9 8.2 7 9.2 4.1-1 7-4.9 7-9.2V6l-7-3Z" /><path d="m9.5 12 1.7 1.7 3.3-3.4" /></svg>`
    case 'ai':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="2.5" /><path d="M12 3v3" /><path d="M12 18v3" /><path d="M4.2 7.2 6.3 9.3" /><path d="M17.7 14.7 19.8 16.8" /><path d="M3 12h3" /><path d="M18 12h3" /><path d="M4.2 16.8 6.3 14.7" /><path d="M17.7 9.3 19.8 7.2" /></svg>`
    case 'copilot':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 17.5h9a3.5 3.5 0 0 0 0-7 4.5 4.5 0 0 0-8.6-1.8A3.5 3.5 0 0 0 7.5 17.5Z" /><path d="M9.2 13.2c.9-.8 1.8-1.2 2.8-1.2s1.9.4 2.8 1.2" /><path d="M9.8 9.8h.01" /><path d="M14.2 9.8h.01" /></svg>`
    case 'claude':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5.5A6.5 6.5 0 1 0 15 18.5" /><path d="M9 12h7" /><path d="M14.5 8.5H18" /><path d="M14.5 15.5H18" /></svg>`
    case 'gemini':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c.7 4.3 3.7 7.3 8 8-.4 0-.8.1-1.2.1-3.7.3-6.6 3.2-6.8 6.9 0 .4 0 .7 0 1-.7-4.3-3.7-7.3-8-8 4.3-.7 7.3-3.7 8-8Z" /></svg>`
    case 'codex':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 8 5 12l3.5 4" /><path d="M15.5 8 19 12l-3.5 4" /><path d="M13 6 11 18" /></svg>`
    case 'docker':
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5h12.5a3.5 3.5 0 0 1-3.5 3.5H9a5 5 0 0 1-5-5v-1.5Z" /><path d="M8 12.5v-3h3v3" /><path d="M11 12.5V8.5h3v4" /><path d="M14 12.5v-2h3v2" /><path d="M18 11.2c1.7-.3 2.4.4 2.8 1.3-.8.7-1.6 1-2.8 1" /></svg>`
    default:
      return ''
  }
}
---

<section class="toolbelt" aria-label={t.ariaLabel}>
  <div class="toolbelt__inner">
    <h2 class="toolbelt__title" data-i18n="toolbelt.title">{t.title}</h2>

    <div class="toolbelt__rail" role="list">
      {
        t.items.map((item) => (
          <span
            class="toolbelt__icon"
            role="img"
            aria-label={item.label}
            title={item.label}
            set:html={renderIcon(item.icon)}
          ></span>
        ))
      }
    </div>
  </div>
</section>

<style>
  .toolbelt {
    padding: var(--space-6) var(--space-8);
    background: var(--color-surface-2);
  }

  .toolbelt__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-8);
    align-items: center;
  }

  .toolbelt__title {
    display: inline-flex;
    align-items: center;
    align-self: center;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    text-align: left;
    line-height: 1;
    white-space: nowrap;
  }

  .toolbelt__title::after {
    content: '>';
    margin-left: 0.45rem;
    font-size: 1.1em;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
  }

  .toolbelt__rail {
    display: grid;
    width: 100%;
    grid-auto-flow: column;
    grid-auto-columns: minmax(2.5rem, 1fr);
    gap: var(--space-4);
    align-items: center;
    justify-items: center;
    overflow: hidden;
    line-height: 0;
  }

  .toolbelt__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-primary);
    flex-shrink: 0;
    transition:
      transform var(--transition-fast),
      color var(--transition-fast),
      filter var(--transition-fast);
  }

  .toolbelt__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .toolbelt__icon:hover {
    transform: translateY(-1px);
    color: var(--color-primary-dim);
    filter: drop-shadow(0 0 8px rgba(0, 240, 255, 0.35));
  }

  @media (max-width: 768px) {
    .toolbelt {
      padding: var(--space-4);
    }

    .toolbelt__inner {
      column-gap: var(--space-4);
      align-items: center;
    }

    .toolbelt__rail {
      grid-auto-columns: minmax(2rem, 1fr);
      gap: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toolbelt__icon {
      transition: none;
    }
  }
</style>
