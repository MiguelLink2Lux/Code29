---
import ContactConversation from '@/components/contact/ContactConversation.vue'
import { translations, type Lang } from '@/i18n/translations'
import { DEFAULT_LANG } from '@/utils/i18n'

const lang: Lang = DEFAULT_LANG
const t = translations.contact[lang]
---

<section class="contact" id="contact" aria-label="Contacto">
  <div class="contact__inner">
    <div class="contact__header">
      <span class="contact__tag" data-i18n="contact.tag">{t.tag}</span>
      <h2 class="contact__title" data-i18n="contact.title">{t.title}</h2>
      <p class="contact__subtitle" data-i18n="contact.subtitle">{t.subtitle}</p>
    </div>

    <div class="contact__form-shell">
      <ContactConversation client:load />
    </div>

    <div class="contact__status" aria-hidden="true" data-i18n="contact.status">
      {t.status}
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    z-index: 1;
    padding: var(--space-16) var(--space-8);
    /* No background and no decoration of its own: both belong to the closing
       block in BaseLayout, which is what makes contact and footer read as one
       surface instead of two. */
  }

  .contact__inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    text-align: center;
  }

  .contact__tag {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--color-primary);
  }

  .contact__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__form-shell {
    position: relative;
    width: 100%;
    padding: var(--space-4);
  }

  .contact__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
  }

  .contact__subtitle {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* Status bar */
  .contact__status {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    opacity: 0.4;
  }

  @media (max-width: 768px) {
    .contact {
      padding: var(--space-12) var(--space-4);
    }

    .contact__inner {
      gap: var(--space-6);
    }

    .contact__status {
      line-height: 1.6;
    }

    .contact__form-shell {
      padding: var(--space-3);
    }
  }
</style>
