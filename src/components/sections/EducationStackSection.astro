---
// Education & Stack section: AI Master's degree + tech stack grid
import { translations, type Lang } from '@/i18n/translations'
import { DEFAULT_LANG } from '@/utils/i18n'

const lang: Lang = DEFAULT_LANG
const t = translations.educationStack[lang]
---

<section class="stack" id="stack" aria-label="Formación y Stack tecnológico">
  <div class="stack__inner">
    <!-- Education block -->
    <div class="stack__education">
      <span class="stack__section-tag">{t.sectionTagEducation}</span>
      <h2 class="stack__title" data-i18n="educationStack.heading">{t.heading}</h2>
      <p class="stack__description" data-i18n="educationStack.description">{t.description}</p>
      <p class="stack__experience-summary" data-i18n="educationStack.experienceSummary">{t.experienceSummary}</p>
      <dl class="stack__meta">
        <div>
          <dt data-i18n="educationStack.metaSpecialization">{t.metaSpecialization}</dt>
          <dd data-i18n="educationStack.metaSpecializationValue">{t.metaSpecializationValue}</dd>
        </div>
        <div>
          <dt data-i18n="educationStack.metaMethodology">{t.metaMethodology}</dt>
          <dd data-i18n="educationStack.metaMethodologyValue">{t.metaMethodologyValue}</dd>
        </div>
        <div>
          <dt data-i18n="educationStack.metaExperience">{t.metaExperience}</dt>
          <dd data-i18n="educationStack.metaExperienceValue">{t.metaExperienceValue}</dd>
        </div>
      </dl>
    </div>

    <!-- Stack grid -->
    <div class="stack__tech">
      <span class="stack__section-tag">{t.sectionTagStack}</span>
      <ul class="stack__grid" role="list" aria-label={t.stackAriaLabel}>
        {
          t.items.map((item) => (
            <li class="stack__item" data-category={item.category}>
              {item.name}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .stack {
    position: relative;
    padding: var(--space-16) var(--space-8);
    background: var(--color-base);
    overflow: hidden;
  }

  .stack::before,
  .stack::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stack::before {
    background-image:
      linear-gradient(rgba(0, 240, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 240, 255, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.78;
  }

  .stack::after {
    background:
      linear-gradient(90deg, transparent 0%, rgba(0, 240, 255, 0.16) 48%, transparent 56%) -120% 0 / 180% 100% no-repeat,
      radial-gradient(circle at 24% 22%, rgba(0, 240, 255, 0.1), transparent 18%),
      radial-gradient(circle at 74% 68%, rgba(157, 0, 255, 0.08), transparent 22%);
    opacity: 0.5;
    animation: stack-grid-scan 10s linear infinite;
  }

  .stack__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  @media (max-width: 768px) {
    .stack__inner {
      grid-template-columns: 1fr;
    }
  }

  .stack__section-tag {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  .stack__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .stack__description {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .stack__experience-summary {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: var(--space-8);
  }

  /* Meta details */
  .stack__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stack__meta div {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .stack__meta dt {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    min-width: 130px;
  }

  .stack__meta dd {
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  /* Stack grid */
  .stack__grid {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .stack__item {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    padding: var(--space-2) var(--space-4);
    box-shadow: var(--shadow-ambient);
    transition:
      color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .stack__item:hover {
    color: var(--color-primary);
    box-shadow: 0px 0px 8px rgba(0, 240, 255, 0.15);
  }

  /* Category accent colors */
  .stack__item[data-category='ai'] {
    border-bottom: 2px solid rgba(0, 240, 255, 0.3);
  }

  .stack__item[data-category='infra'] {
    border-bottom: 2px solid rgba(157, 0, 255, 0.3);
  }

  @keyframes stack-grid-scan {
    0% {
      background-position:
        -120% 0,
        24% 22%,
        74% 68%;
      opacity: 0.28;
    }

    50% {
      background-position:
        20% 0,
        24% 22%,
        74% 68%;
      opacity: 0.5;
    }

    100% {
      background-position:
        120% 0,
        24% 22%,
        74% 68%;
      opacity: 0.28;
    }
  }

  @media (max-width: 768px) {
    .stack {
      padding: var(--space-12) var(--space-4);
    }

    .stack__inner {
      gap: var(--space-8);
    }

    .stack__meta div {
      flex-direction: column;
      gap: var(--space-1);
    }

    .stack__meta dt {
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack::after {
      animation: none;
    }
  }
</style>
