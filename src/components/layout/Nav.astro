---
// Navigation bar: logo, section links, CTA, language switcher
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import { translations, type Lang } from '@/i18n/translations'
import { DEFAULT_LANG } from '@/utils/i18n'

const lang: Lang = DEFAULT_LANG
const t = translations.nav[lang]
---

<nav class="nav">
  <a href="/" class="nav__logo" aria-label="CODE29 — Inicio">
    CODE<span class="nav__logo-accent">29</span>
  </a>

  <ul class="nav__links" role="list">
    {
      t.links.map((link, i) => (
        <li>
          <a href={link.href} class="nav__link" data-i18n={`nav.links.${i}.label`}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="nav__actions">
    <LanguageSwitcher />
    <a href="#contacto" class="nav__cta" data-i18n="nav.cta">{t.cta}</a>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-8);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }

  /* Logo */
  .nav__logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav__logo:hover {
    color: var(--color-primary);
  }

  .nav__logo-accent {
    color: var(--color-primary);
  }

  /* Nav links */
  .nav__links {
    display: flex;
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav__link:hover {
    color: var(--color-primary);
  }

  /* Actions group: switcher + CTA */
  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* CTA button */
  .nav__cta {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-base);
    background: var(--btn-gradient);
    text-decoration: none;
    padding: var(--space-2) var(--space-6);
    box-shadow: var(--btn-glow);
    transition:
      box-shadow var(--transition-fast),
      opacity var(--transition-fast);
  }

  .nav__cta:hover {
    box-shadow: 0px 0px 12px var(--color-primary);
    opacity: 0.9;
  }
</style>
