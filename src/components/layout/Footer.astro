---
// Footer: legal links and cookie preferences button
// The cookie preferences button emits a custom event consumed by CookieBanner.vue (Phase 3)
import { translations, type Lang } from '@/i18n/translations'
import { DEFAULT_LANG } from '@/utils/i18n'

interface Props {
  transparent?: boolean
}

const { transparent = false } = Astro.props
const lang: Lang = DEFAULT_LANG
const t = translations.footer[lang]
---

<footer class:list={['footer', transparent && 'footer--transparent']}>
  <div class="footer__status" aria-hidden="true" data-i18n="footer.status">
    {t.status}
  </div>

  <div class="footer__bottom">
    <p class="footer__copy" data-i18n="footer.copy">{t.copy}</p>

    <nav class="footer__legal" aria-label="Legal">
      {
        t.legalLinks.map((link, i) => (
          <a href={link.href} class="footer__legal-link" data-i18n={`footer.legalLinks.${i}.label`}>
            {link.label}
          </a>
        ))
      }
      <button
        id="cookie-preferences-btn"
        class="footer__cookie-btn"
        type="button"
        aria-label="Abrir preferencias de cookies"
        data-i18n="footer.cookiePreferences"
      >
        {t.cookiePreferences}
      </button>
    </nav>
  </div>
</footer>

<script>
  // Dispatches a custom event so CookieBanner.vue can open the preferences panel
  const btn = document.getElementById('cookie-preferences-btn')
  btn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cookie-preferences'))
  })
</script>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: var(--space-8);
    background: var(--color-surface-1);
    overflow: hidden;
  }

  /* Transparent because something else paints behind it: on the home page the
     closing block in BaseLayout carries the surface and the decoration for both
     contact and footer at once. */
  .footer--transparent {
    background: transparent;
  }

  .footer__status,
  .footer__bottom {
    position: relative;
    z-index: 1;
  }

  /* System status bar */
  .footer__status {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: center;
    padding-bottom: var(--space-6);
    opacity: 0.6;
  }

  /* Bottom row */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer__copy {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  /* Legal nav */
  .footer__legal {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .footer__legal-link {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer__legal-link:hover {
    color: var(--color-primary);
  }

  /* Cookie preferences button — ghost style */
  .footer__cookie-btn {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color var(--transition-fast);
  }

  .footer__cookie-btn:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .footer {
      padding: var(--space-6) var(--space-4);
    }

    .footer__bottom,
    .footer__legal {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__status,
    .footer__copy {
      line-height: 1.6;
    }
  }

</style>
