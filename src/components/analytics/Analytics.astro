---
// GA4 with Consent Mode v2 — the tag is loaded only after analytics consent.
//
// The measurement id travels in a meta tag rather than through define:vars,
// because this script imports the analytics abstraction and Astro does not allow
// combining the two. Renders nothing if PUBLIC_GA4_ID is unset (safe in dev).
const GA_ID = import.meta.env.PUBLIC_GA4_ID
---

{GA_ID && (
  <>
    <meta name="ga4-measurement-id" content={GA_ID} />
    <script>
      import { AnalyticsService } from '@/utils/analytics'

      const id = document
        .querySelector('meta[name="ga4-measurement-id"]')
        ?.getAttribute('content')

      // Declares consent as denied and loads the tag only for a visitor who
      // already granted analytics. A first-time visitor sends nothing until
      // they choose — Consent Mode's denied ping would still reach Google.
      if (id) AnalyticsService.bootstrap(id)
    </script>
  </>
)}
