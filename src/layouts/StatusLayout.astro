---
import Footer from '@/components/layout/Footer.astro'
import Nav from '@/components/layout/Nav.astro'

interface Props {
  title: string
  description: string
  noindex?: boolean
}

const { title, description, noindex = true } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — CODE29</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="status-shell">
      <div class="status-shell__noise" aria-hidden="true"></div>
      <div class="status-shell__glow status-shell__glow--primary" aria-hidden="true"></div>
      <div class="status-shell__glow status-shell__glow--secondary" aria-hidden="true"></div>
      <Nav />
      <main class="status-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-body);
    background:
      radial-gradient(circle at top left, rgba(0, 240, 255, 0.08), transparent 28%),
      radial-gradient(circle at bottom right, rgba(157, 0, 255, 0.08), transparent 26%),
      linear-gradient(180deg, var(--color-base), #0e0e0f);
    color: var(--color-text);
    -webkit-font-smoothing: antialiased;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100dvh;
    background:
      radial-gradient(circle at 1px 1px, rgba(59, 73, 75, 0.22) 1px, transparent 0);
    background-size: 40px 40px;
  }

  a {
    color: inherit;
  }

  button,
  input {
    font: inherit;
  }

  .status-shell {
    position: relative;
    min-height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-direction: column;
  }

  .status-shell__noise {
    position: fixed;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    opacity: 0.04;
    background-image:
      linear-gradient(90deg, transparent 0 97%, rgba(229, 226, 227, 0.08) 97% 100%),
      linear-gradient(transparent 0 97%, rgba(229, 226, 227, 0.08) 97% 100%);
    background-size: 5px 5px;
    mix-blend-mode: soft-light;
  }

  .status-shell__glow {
    position: fixed;
    z-index: -2;
    border-radius: 9999px;
    filter: blur(120px);
    pointer-events: none;
    opacity: 0.6;
  }

  .status-shell__glow--primary {
    top: 8rem;
    left: -6rem;
    width: 24rem;
    height: 24rem;
    background: rgba(0, 240, 255, 0.12);
  }

  .status-shell__glow--secondary {
    right: -10rem;
    bottom: 2rem;
    width: 28rem;
    height: 28rem;
    background: rgba(157, 0, 255, 0.12);
  }

  .status-main {
    flex: 1;
    padding: var(--space-16) var(--space-8);
  }

  .status-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .status-eyebrow::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-secondary);
    box-shadow: 0 0 12px rgba(157, 0, 255, 0.8);
    animation: status-pulse 1.8s infinite ease-in-out;
  }

  .status-panel {
    background: linear-gradient(180deg, rgba(28, 27, 28, 0.92), rgba(42, 42, 43, 0.88));
    box-shadow:
      var(--shadow-ambient),
      inset 0 0 0 1px rgba(0, 240, 255, 0.05);
  }

  .status-mono {
    font-family: var(--font-display);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .status-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 3rem;
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      opacity var(--transition-fast);
  }

  .status-link:hover {
    transform: translateY(-1px);
  }

  .status-link--primary {
    color: var(--color-base);
    background: var(--btn-gradient);
    box-shadow: var(--btn-glow);
  }

  .status-link--secondary {
    color: var(--color-text);
    background: rgba(42, 42, 43, 0.92);
    box-shadow: inset 0 0 0 1px rgba(229, 226, 227, 0.08);
  }

  .status-field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: var(--input-border-bottom);
    transition: border-color var(--transition-fast);
  }

  .status-field:focus-within {
    border-bottom: var(--input-border-focus);
  }

  .status-field input {
    width: 100%;
    background: transparent;
    color: var(--color-text);
    border: 0;
    outline: 0;
  }

  .status-field input::placeholder {
    color: rgba(154, 152, 153, 0.72);
  }

  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.9);
    }

    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 900px) {
    .status-main {
      padding-left: var(--space-4);
      padding-right: var(--space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
