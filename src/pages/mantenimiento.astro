---
import StatusLayout from '@/layouts/StatusLayout.astro'
---

<StatusLayout
  title="Mantenimiento del sistema"
  description="CODE29 esta en mantenimiento. El nucleo de IA se esta optimizando y volvera en breve."
>
  <section class="maintenance">
    <header class="maintenance__header">
      <span class="status-eyebrow">System state: maintenance mode</span>
      <h1>SISTEMA_EN_MANTENIMIENTO</h1>
      <p>
        Estamos actualizando el nucleo de IA para ofrecer una experiencia superior. La red CODE29
        vuelve en breve.
      </p>
    </header>

    <div class="maintenance__grid">
      <article class="status-panel maintenance__card maintenance__card--progress">
        <div class="maintenance__card-head">
          <p class="status-mono">Task: core_optimization_v2.9</p>
          <strong>74.2% complete</strong>
        </div>

        <div class="maintenance__progress" aria-label="Progreso estimado de mantenimiento">
          <span class="maintenance__progress-fill"></span>
        </div>

        <div class="maintenance__stats">
          <div>
            <span>Status</span>
            <strong>Optimizacion en curso</strong>
          </div>
          <div>
            <span>ETA</span>
            <strong>00:42:15 UTC</strong>
          </div>
        </div>
      </article>

      <aside class="status-panel maintenance__card maintenance__card--logs">
        <div class="maintenance__terminal-head">
          <span class="status-mono">Terminal feed</span>
          <span class="status-mono maintenance__recording">REC</span>
        </div>

        <ul>
          <li>&gt; SHUTTING_DOWN_REPLICATORS</li>
          <li>&gt; PURGING_CACHE_REGISTRIES</li>
          <li>&gt; INJECTING_NEURAL_PATH_V2</li>
          <li class="maintenance__active">&gt; OPTIMIZING_DATA_FLOW...</li>
        </ul>
      </aside>
    </div>

    <div class="status-panel maintenance__bottom">
      <p class="status-mono">Sigue la evolucion de la arquitectura:</p>

      <div class="maintenance__links">
        <a href="/">Inicio</a>
        <a href="/aviso-legal">Marco legal</a>
        <a href="/cookies">Preferencias de cookies</a>
      </div>
    </div>
  </section>
</StatusLayout>

<style>
  .maintenance {
    max-width: 72rem;
    min-height: calc(100dvh - 11.5rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-8);
  }

  .maintenance__header {
    max-width: 48rem;
    padding-left: var(--space-6);
    background: linear-gradient(90deg, rgba(0, 240, 255, 0.12), transparent 18%);
  }

  .maintenance__header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
    color: var(--color-primary-dim);
    margin: var(--space-4) 0;
  }

  .maintenance__header p {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .maintenance__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    gap: 0.125rem;
  }

  .maintenance__card {
    padding: var(--space-8);
  }

  .maintenance__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .maintenance__card-head p,
  .maintenance__card-head strong,
  .maintenance__stats span,
  .maintenance__stats strong,
  .maintenance__terminal-head,
  .maintenance__links a {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .maintenance__card-head p,
  .maintenance__stats span,
  .maintenance__terminal-head {
    color: var(--color-text-muted);
    font-size: 0.6875rem;
  }

  .maintenance__card-head strong,
  .maintenance__stats strong {
    color: var(--color-primary-dim);
    font-size: 0.875rem;
  }

  .maintenance__progress {
    position: relative;
    height: 0.375rem;
    margin-bottom: var(--space-8);
    background: rgba(58, 57, 58, 0.68);
  }

  .maintenance__progress-fill {
    display: block;
    width: 74.2%;
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary-dim), var(--color-primary));
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.4);
  }

  .maintenance__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .maintenance__stats div {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: rgba(19, 19, 20, 0.42);
  }

  .maintenance__terminal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .maintenance__recording {
    color: var(--color-primary);
  }

  .maintenance__card--logs ul {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  .maintenance__card--logs li {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .maintenance__active {
    color: var(--color-primary-dim);
  }

  .maintenance__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6);
  }

  .maintenance__bottom p {
    color: var(--color-text-muted);
    font-size: 0.6875rem;
  }

  .maintenance__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .maintenance__links a {
    color: var(--color-text);
    font-size: 0.75rem;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .maintenance__links a:hover {
    color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .maintenance__grid {
      grid-template-columns: 1fr;
    }

    .maintenance__card-head,
    .maintenance__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .maintenance__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
