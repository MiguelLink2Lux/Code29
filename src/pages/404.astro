---
import StatusLayout from '@/layouts/StatusLayout.astro'
---

<StatusLayout
  title="Error 404"
  description="Ruta no encontrada en CODE29. La dirección solicitada no existe o ya no está disponible."
>
  <section class="error-404">
    <div class="error-404__hero">
      <div class="error-404__code">
        <span class="status-eyebrow">System critical exception</span>
        <h1>404</h1>
      </div>

      <div class="error-404__intro">
        <h2>PAGINA_NO_ENCONTRADA // RUTA_INVALIDA</h2>
        <p>
          El nodo solicitado no existe en la topografia actual. El sistema no ha podido localizar
          la direccion especificada dentro de la red CODE29.
        </p>
      </div>
    </div>

    <div class="error-404__grid">
      <article class="status-panel error-404__panel error-404__panel--main">
        <p class="status-mono error-404__label">Resolucion de conflictos</p>
        <div class="error-404__main-row">
          <div>
            <p class="error-404__status">&gt; STATUS_CODE: 0x29_MISSING_NODE</p>
            <p class="error-404__detail">Iniciando protocolo de recuperacion de ruta...</p>
          </div>

          <div class="error-404__actions">
            <a class="status-link status-link--primary" href="/">Volver al inicio</a>
            <a class="status-link status-link--secondary" href="/#contacto">Solicitar soporte</a>
          </div>
        </div>
      </article>

      <aside class="status-panel error-404__panel error-404__panel--meta">
        <p class="status-mono error-404__label">Topografia de red</p>
        <dl class="error-404__metrics">
          <div>
            <dt>Latency</dt>
            <dd>0.002ms</dd>
          </div>
          <div>
            <dt>Node_ID</dt>
            <dd>CN-2900</dd>
          </div>
          <div>
            <dt>Reachability</dt>
            <dd class="error-404__metrics-error">NULL</dd>
          </div>
        </dl>
      </aside>
    </div>

    <div class="status-panel error-404__bar">
      <div>
        <span>Uptime</span>
        <strong>99.998%</strong>
      </div>
      <div>
        <span>Packets</span>
        <strong>Dropped</strong>
      </div>
      <div>
        <span>Recovery route</span>
        <strong>Back to root</strong>
      </div>
    </div>
  </section>
</StatusLayout>

<style>
  .error-404 {
    max-width: 80rem;
    min-height: calc(100dvh - 11.5rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-8);
  }

  .error-404__hero {
    display: grid;
    grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: end;
  }

  .error-404__code h1 {
    font-family: var(--font-display);
    font-size: clamp(6rem, 18vw, 14rem);
    line-height: 0.92;
    letter-spacing: -0.08em;
    color: var(--color-primary-dim);
    text-shadow:
      2px 0 rgba(0, 240, 255, 0.85),
      -2px 0 rgba(157, 0, 255, 0.72);
  }

  .error-404__intro {
    padding: var(--space-6);
    background: linear-gradient(90deg, rgba(42, 42, 43, 0.35), transparent);
  }

  .error-404__intro h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  .error-404__intro p,
  .error-404__detail {
    max-width: 38rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .error-404__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr);
    gap: 0.125rem;
  }

  .error-404__panel {
    padding: var(--space-8);
  }

  .error-404__label {
    font-size: 0.625rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .error-404__main-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .error-404__status {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .error-404__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .error-404__metrics {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .error-404__metrics div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: rgba(19, 19, 20, 0.42);
  }

  .error-404__metrics dt,
  .error-404__metrics dd,
  .error-404__bar span,
  .error-404__bar strong {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .error-404__metrics dt,
  .error-404__bar span {
    color: var(--color-text-muted);
  }

  .error-404__metrics dd,
  .error-404__bar strong {
    color: var(--color-primary-dim);
  }

  .error-404__metrics-error {
    color: #ffb4ab;
  }

  .error-404__bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.125rem;
    padding: var(--space-4) var(--space-6);
  }

  .error-404__bar div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3);
    background: rgba(14, 14, 15, 0.7);
  }

  @media (max-width: 900px) {
    .error-404__hero,
    .error-404__grid,
    .error-404__bar {
      grid-template-columns: 1fr;
    }

    .error-404__main-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
